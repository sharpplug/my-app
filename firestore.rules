rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile directory. Any signed-in user can look someone up by
    // uid or by handle (via /handles) to send them money; only the owner
    // can create/modify their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.handle == resource.data.handle;
      allow delete: if false;
    }

    // handles/{handle} reserves a unique @handle -> uid mapping. Handles
    // are permanent once claimed (no rename support yet) so a simple
    // create-once rule is enough to prevent two accounts from colliding.
    match /handles/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/handles/$(handle));
      allow update, delete: if false;
    }

    // Wallet balances are read-only from the client. Every mutation (send,
    // top-up, swap, gift, purchase) runs through a Cloud Function using the
    // Admin SDK, which bypasses these rules entirely - there is no path
    // here for a client to write balance/tokenBalance to any value it
    // likes. See functions/src/index.ts.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Pending/completed top-up intents (bringing outside money in via
    // card, mobile money, or bank - see functions/src/index.ts). Only
    // initiateTopUp (Admin SDK) creates these and only completeTopUpIntent
    // (Admin SDK, via topUpWebhook or the demo simulateTopUpConfirmation)
    // ever changes their status - the client can look up its own intents
    // to show progress, but never write to them directly.
    match /topupIntents/{intentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Withdrawal intents (moving wallet balance back out) - the mirror of
    // topupIntents above. initiateWithdrawal (Admin SDK) already debited
    // the wallet by the time this doc exists, so it's read-only from the
    // client for the same reason.
    match /withdrawalIntents/{intentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Real partner marketplace listings (Shop's Create Listing flow).
    // Unlike wallet writes, listing a product doesn't move money, so a
    // direct client write is fine as long as: you can only list as
    // yourself, the price is a real positive number, and you're actually a
    // partner (role check via a get() lookup on your own profile - partners
    // are granted that role by becomePartner() in src/lib/users.ts).
    // Buying a listing (spendFunds with a productId) is the part that
    // moves money and is Cloud-Function-only, same as every other wallet
    // mutation.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner';
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // The Vibes feed. Posts are readable by any signed-in user; only the
    // author can create/delete their own post. Likes/waves are the one
    // exception to "author only" - any signed-in user may flip their own
    // uid in or out of likedBy/wavedBy, but nothing else about the post.
    match /vibePosts/{postId} {
      function isAuthor() {
        return request.auth != null && request.auth.uid == resource.data.authorUid;
      }

      function isLikeOrWaveToggle() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likedBy', 'likes', 'wavedBy', 'waves']);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthor() || isLikeOrWaveToggle();
      allow delete: if isAuthor();

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Live location for the Vibes Map / Ghost Mode. Ghost Mode works by
    // simply not having a document here at all, so there's nothing for
    // other users to read - no "hidden" flag that a client could ignore.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
